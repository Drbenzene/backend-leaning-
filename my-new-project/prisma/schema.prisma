generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}


model User {
  id  Int @id @default(autoincrement())
  name String @db.VarChar(100)
  email String @unique @db.VarChar(100)
  phone String @unique @db.VarChar(11)
  password String
  username String
  dob String
  createdAt DateTime @default(now())
}
